#!/usr/bin/env sh
# n6-lsp launcher. The canonical grammar source is lsp/n6_lsp.hexa (hexa-native
# port; spec/n6.md SSOT). `--check FILE` (CI lint) routes to the hexa-native port;
# the interactive stdio JSON-RPC server stays on the .py here (the compiled
# n6-lsp-hexa with the read_stdin_n_c FFI is what the installed ~/.local/bin
# wrapper runs for --stdio — see lsp/n6_lsp.hexa header).
dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
hexa_bin="$HOME/.hx/bin/hexa"
if [ "$1" = "--check" ] && [ -x "$hexa_bin" ]; then
  exec "$hexa_bin" run --no-sentinel "$dir/lsp/n6_lsp.hexa" "$@"
fi
exec python3 "$dir/lsp/n6_lsp.py" "$@"
